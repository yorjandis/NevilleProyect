    <!-- Características premium -->
    <string name="premium_exclusive_content_title">Contenido exclusivo</string>
    <string name="premium_exclusive_content_description">Accede a frases y enseñanzas de Joe Dispenza, Bruce Lipton, Gregg Braden y otros autores.</string>
    <string name="premium_goals_title">Metas y transformación personal</string>
    <string name="premium_goals_description">Define objetivos, sigue hábitos saludables y utiliza programas prácticos para impulsar tu cambio.</string>
    <string name="premium_canvas_title">Lienzo creativo</string>
    <string name="premium_canvas_description">Crea imágenes con tus citas favoritas para compartirlas o usarlas como tarjetas de enfoque.</string>
    <string name="premium_morning_ritual_title">Ritual Matutino</string>
    <string name="premium_morning_ritual_description">Diseña cada día con intención y lleva un registro del progreso de tu transformación.</string>
    <string name="premium_evening_ritual_title">Ritual de Cierre</string>
    <string name="premium_evening_ritual_description">Revisa cómo has vivido el día, integra lo aprendido y prepara con claridad tu intención para mañana.</string>
    <string name="premium_agenda_title">Agenda</string>
    <string name="premium_agenda_description">Organiza tus actividades y tareas, y añade recordatorios para no olvidar lo importante.</string>
    <string name="premium_coherence_title">Coherencia cardio-cerebral</string>
    <string name="premium_coherence_description">Sigue una guía visual para sincronizar corazón y cerebro y entrar en un estado de coherencia.</string>
    <string name="premium_presence_title">Presencia Consciente</string>
    <string name="premium_presence_description">Registra pequeños momentos de despertar durante el día y vuelve al presente con un solo toque.</string>
    <string name="premium_calm_space_title">Espacio de Calma</string>
    <string name="premium_calm_space_description">Disfruta de esferas relajantes, música, frases y fondos inmersivos.</string>
    <string name="premium_healing_center_title">Centro Sanador</string>
    <string name="premium_healing_center_description">Comprende mejor lo que te ocurre y practica técnicas guiadas de regulación, con indicaciones de seguridad y acceso a recursos de ayuda.</string>
    <string name="premium_reminders_title">Recordatorios inteligentes</string>
    <string name="premium_reminders_description">Programa avisos para tareas y prácticas como meditar, agradecer o revisar tus metas.</string>
    <string name="premium_encyclopedia_title">Enciclopedia</string>
    <string name="premium_encyclopedia_description">Consulta conocimientos prácticos sobre neurociencia, meditación, hábitos y temas relacionados.</string>
    <string name="premium_scientific_evidence_title">Evidencia científica</string>
    <string name="premium_scientific_evidence_description">Explora investigaciones que respaldan estas enseñanzas en resúmenes fáciles de consultar.</string>
    <string name="premium_emotional_anchors_title">Anclas Emocionales</string>
    <string name="premium_emotional_anchors_description">Utiliza una herramienta cognitiva guiada para afrontar momentos de estrés.</string>
    <string name="premium_voice_notes_title">Notas de voz</string>
    <string name="premium_voice_notes_description">Graba y reproduce ideas o reflexiones sin necesidad de escribirlas.</string>
    <string name="premium_weekly_summary_title">Resumen Semanal</string>
    <string name="premium_weekly_summary_description">Consulta estadísticas generales y conserva un histórico de tu evolución.</string>
    <string name="premium_protected_notes_title">Notas protegidas</string>
    <string name="premium_protected_notes_description">Protege tus notas privadas mediante autenticación biométrica.</string>
    <string name="premium_paste_into_title">Menú «Pegar en»</string>
    <string name="premium_paste_into_description">Convierte rápidamente el texto seleccionado en una nota, un lienzo o una frase.</string>
    <string name="premium_health_quotes_title">Frases de salud</string>
    <string name="premium_health_quotes_description">Amplía tu biblioteca con frases de salud y contenidos de autores adicionales.</string>


