    <string name="breathing_physiological_sigh_name">Suspiro fisiológico</string>
    <string name="breathing_physiological_sigh_pattern">2 inhalaciones nasales + 1 exhalación larga por la boca</string>
    <string name="breathing_physiological_sigh_guide">Haz una inhalación nasal normal, añade una segunda inhalación corta para expandir los pulmones y termina con una exhalación larga por la boca. Repite de 3 a 5 veces.</string>
    <string name="breathing_physiological_sigh_effect">Reduce la activación en segundos y corta los picos de ansiedad.</string>
    <string name="breathing_coherent_name">Respiración coherente 4-6</string>
    <string name="breathing_coherent_pattern">Inhala 4 s y exhala 6 s</string>
    <string name="breathing_coherent_guide">Respira por la nariz durante 4 segundos y exhala durante 6 segundos, de forma suave y continua. Mantén el ritmo entre 1 y 3 minutos.</string>
    <string name="breathing_coherent_effect">Reduce la frecuencia cardiaca y mejora la sensación de control.</string>
    <string name="breathing_box_name">Caja 4-4-4-4</string>
    <string name="breathing_box_pattern">Inhala 4 s, pausa 4 s, exhala 4 s, pausa 4 s</string>
    <string name="breathing_box_guide">Sigue cuatro fases iguales de 4 segundos. Completa de 4 a 6 ciclos.</string>
    <string name="breathing_box_effect">Ordena la mente y mejora el enfoque cuando hay sobrecarga mental.</string>
    <string name="breathing_relax_name">4-7-8</string>
    <string name="breathing_relax_pattern">Inhala 4 s, sostén 7 s y exhala 8 s</string>
    <string name="breathing_relax_guide">Haz ciclos lentos siguiendo el patrón 4-7-8. Empieza con 3 o 4 rondas.</string>
    <string name="breathing_relax_effect">Reduce la hiperactivación y favorece una calma rápida.</string>
    <string name="breathing_long_exhale_name">Exhalación larga 4-8</string>
    <string name="breathing_long_exhale_pattern">Inhala 4 s y exhala 8 s</string>
    <string name="breathing_long_exhale_guide">Respira cómodamente y procura que la exhalación sea más larga que la inhalación. Practica durante 1 o 2 minutos.</string>
    <string name="breathing_long_exhale_effect">Activa el sistema parasimpático y reduce la tensión corporal.</string>

