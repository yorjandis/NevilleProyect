    <!-- 高级功能 -->
    <string name="premium_exclusive_content_title">独家内容</string>
    <string name="premium_exclusive_content_description">探索乔·迪斯本扎、布鲁斯·利普顿、格雷格·布雷登等作者的语录与思想。</string>
    <string name="premium_goals_title">目标与个人成长</string>
    <string name="premium_goals_description">设定目标、培养健康习惯，并通过实用计划推动持续改变。</string>
    <string name="premium_canvas_title">创意画布</string>
    <string name="premium_canvas_description">把喜爱的语录制作成图片，用于分享或作为专注卡片。</string>
    <string name="premium_morning_ritual_title">晨间仪式</string>
    <string name="premium_morning_ritual_description">带着明确意图开启每一天，并记录自己的成长进展。</string>
    <string name="premium_evening_ritual_title">晚间复盘</string>
    <string name="premium_evening_ritual_description">回顾一天的经历，沉淀所学，并为明天明确方向。</string>
    <string name="premium_agenda_title">日程管理</string>
    <string name="premium_agenda_description">安排活动和任务，并设置提醒，不错过重要事项。</string>
    <string name="premium_coherence_title">心脑协调</string>
    <string name="premium_coherence_description">跟随视觉引导协调心脏与大脑，逐步进入身心一致的状态。</string>
    <string name="premium_presence_title">正念觉察</string>
    <string name="premium_presence_description">记录一天中短暂的觉察时刻，轻点一下即可回到当下。</string>
    <string name="premium_calm_space_title">静心空间</string>
    <string name="premium_calm_space_description">通过舒缓的球体、音乐、语录和沉浸式背景放松身心。</string>
    <string name="premium_healing_center_title">身心调适中心</string>
    <string name="premium_healing_center_description">更好地理解当下的感受，练习引导式调节技巧，并查看安全提示与求助资源。</string>
    <string name="premium_reminders_title">智能提醒</string>
    <string name="premium_reminders_description">为任务以及冥想、感恩、回顾目标等练习设置提醒。</string>
    <string name="premium_encyclopedia_title">知识百科</string>
    <string name="premium_encyclopedia_description">了解神经科学、冥想、习惯及相关主题的实用知识。</string>
    <string name="premium_scientific_evidence_title">科学依据</string>
    <string name="premium_scientific_evidence_description">通过清晰易读的摘要，了解与这些理念相关的研究。</string>
    <string name="premium_emotional_anchors_title">情绪锚定</string>
    <string name="premium_emotional_anchors_description">通过引导式认知工具，应对压力时刻。</string>
    <string name="premium_voice_notes_title">语音笔记</string>
    <string name="premium_voice_notes_description">无需书写，也能录制并回听想法或感悟。</string>
    <string name="premium_weekly_summary_title">每周总结</string>
    <string name="premium_weekly_summary_description">查看关键统计数据，并持续保留个人成长记录。</string>
    <string name="premium_protected_notes_title">笔记保护</string>
    <string name="premium_protected_notes_description">使用生物识别验证保护私人笔记。</string>
    <string name="premium_paste_into_title">“粘贴至”菜单</string>
    <string name="premium_paste_into_description">快速把选中的文字转为笔记、画布内容或语录。</string>
    <string name="premium_health_quotes_title">健康语录</string>
    <string name="premium_health_quotes_description">通过健康主题语录和更多作者内容扩充你的语录库。</string>
