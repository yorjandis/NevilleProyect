    <!-- Premium features -->
    <string name="premium_exclusive_content_title">Exclusive content</string>
    <string name="premium_exclusive_content_description">Explore quotes and teachings from Joe Dispenza, Bruce Lipton, Gregg Braden, and other authors.</string>
    <string name="premium_goals_title">Goals and personal growth</string>
    <string name="premium_goals_description">Set goals, build healthy habits, and follow practical programs that support lasting change.</string>
    <string name="premium_canvas_title">Creative Canvas</string>
    <string name="premium_canvas_description">Turn your favorite quotes into images to share or use as focus cards.</string>
    <string name="premium_morning_ritual_title">Morning Ritual</string>
    <string name="premium_morning_ritual_description">Start each day with intention and track your progress as you grow.</string>
    <string name="premium_evening_ritual_title">Evening Ritual</string>
    <string name="premium_evening_ritual_description">Review how you lived your day, integrate what you learned, and set a clear intention for tomorrow.</string>
    <string name="premium_agenda_title">Planner</string>
    <string name="premium_agenda_description">Organize activities and tasks, and add reminders so you don’t miss what matters.</string>
    <string name="premium_coherence_title">Heart–brain coherence</string>
    <string name="premium_coherence_description">Follow a visual guide to synchronize your heart and brain and enter a coherent state.</string>
    <string name="premium_presence_title">Mindful Presence</string>
    <string name="premium_presence_description">Record brief moments of awareness throughout the day and return to the present with one tap.</string>
    <string name="premium_calm_space_title">Calm Space</string>
    <string name="premium_calm_space_description">Unwind with soothing spheres, music, quotes, and immersive backgrounds.</string>
    <string name="premium_healing_center_title">Healing Center</string>
    <string name="premium_healing_center_description">Better understand what you’re experiencing and practice guided regulation techniques, with safety advice and access to support resources.</string>
    <string name="premium_reminders_title">Smart reminders</string>
    <string name="premium_reminders_description">Schedule reminders for tasks and practices such as meditation, gratitude, or reviewing your goals.</string>
    <string name="premium_encyclopedia_title">Encyclopedia</string>
    <string name="premium_encyclopedia_description">Explore practical knowledge about neuroscience, meditation, habits, and related topics.</string>
    <string name="premium_scientific_evidence_title">Scientific evidence</string>
    <string name="premium_scientific_evidence_description">Explore research related to these teachings through clear, easy-to-read summaries.</string>
    <string name="premium_emotional_anchors_title">Emotional Anchors</string>
    <string name="premium_emotional_anchors_description">Use a guided cognitive tool to navigate moments of stress.</string>
    <string name="premium_voice_notes_title">Voice notes</string>
    <string name="premium_voice_notes_description">Record and replay ideas or reflections without having to write them down.</string>
    <string name="premium_weekly_summary_title">Weekly Summary</string>
    <string name="premium_weekly_summary_description">Review key statistics and keep a history of your progress over time.</string>
    <string name="premium_protected_notes_title">Protected notes</string>
    <string name="premium_protected_notes_description">Protect your private notes with biometric authentication.</string>
    <string name="premium_paste_into_title">“Paste into” menu</string>
    <string name="premium_paste_into_description">Quickly turn selected text into a note, a canvas, or a quote.</string>
    <string name="premium_health_quotes_title">Health quotes</string>
    <string name="premium_health_quotes_description">Expand your library with health-focused quotes and content from additional authors.</string>
